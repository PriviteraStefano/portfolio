---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => {
        // Expected id format from folder structure: "<locale>/<slug>"
        // Example: "en/aris-scripting"
        const [locale, slug] = project.id.split("/");

        return {
            params: {
                locale,
                slug,
            },
        };
    });
}

const { locale, slug } = Astro.params as { locale: string; slug: string };
const entryId = `${locale}/${slug}`;
const entry = await getEntry("projects", entryId);

if (!entry) {
    return Astro.redirect(`/${locale}/`);
}

const page = entry.data;
---

<BaseLayout>
    <div
        class="min-h-screen bg-primary dark:bg-secondary text-secondary dark:text-primary"
    >
        <!-- Hero -->
        <div class="max-w-4xl mx-auto px-8 py-20">
            {
                page.period && (
                    <div class="mb-4">
                        <span class="text-sm font-medium text-secondary/60 dark:text-primary/60">
                            {page.period}
                        </span>
                    </div>
                )
            }
            <h1 class="text-4xl md:text-5xl font-bold mb-4">{page.title}</h1>
            {
                page.subtitle && (
                    <p class="text-xl text-secondary/80 dark:text-primary/80 mb-8">
                        {page.subtitle}
                    </p>
                )
            }
            {
                page.overview && (
                    <p class="text-lg leading-relaxed text-secondary/75 dark:text-primary/75">
                        {page.overview}
                    </p>
                )
            }
        </div>

        <!-- Optional Hero Image -->
        {
            page.hero_image && (
                <div class="max-w-4xl mx-auto px-8 pb-8">
                    <img
                        src={page.hero_image}
                        alt={`${page.title} hero`}
                        class="w-full rounded-lg shadow-md"
                    />
                </div>
            )
        }

        <!-- Challenge & Solution -->
        {
            (page.challenge || page.solution) && (
                <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
                    <div class="grid md:grid-cols-2 gap-12">
                        <div>
                            <h2 class="text-2xl font-semibold mb-4">
                                {locale === "it" ? "Sfida" : "Challenge"}
                            </h2>
                            <p class="text-secondary/75 dark:text-primary/75 leading-relaxed">
                                {page.challenge}
                            </p>
                        </div>
                        <div>
                            <h2 class="text-2xl font-semibold mb-4">
                                {locale === "it" ? "Soluzione" : "Solution"}
                            </h2>
                            <p class="text-secondary/75 dark:text-primary/75 leading-relaxed">
                                {page.solution}
                            </p>
                        </div>
                    </div>
                </div>
            )
        }

        <!-- Key Achievements -->
        {
            page.keyAchievements && page.keyAchievements.length > 0 && (
                <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
                    <h2 class="text-3xl font-semibold mb-8">
                        {locale === "it"
                            ? "Risultati chiave"
                            : "Key achievements"}
                    </h2>
                    <div class="grid md:grid-cols-2 gap-6">
                        {page.keyAchievements.map((achievement) => (
                            <div class="border-l-2 border-secondary/30 dark:border-primary/30 pl-6 py-2">
                                <h3 class="text-lg font-semibold mb-2">
                                    {achievement.title}
                                </h3>
                                <p class="text-secondary/70 dark:text-primary/70 text-sm leading-relaxed">
                                    {achievement.description}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            )
        }

        <!-- Metrics -->
        {
            page.metrics && page.metrics.length > 0 && (
                <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
                    <h2 class="text-3xl font-semibold mb-8">
                        {locale === "it" ? "Impatto" : "Impact"}
                    </h2>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                        {page.metrics.map((metric) => (
                            <div class="text-center">
                                <p class="text-4xl font-bold text-secondary dark:text-primary mb-2">
                                    {metric.value}
                                </p>
                                <p class="text-sm text-secondary/60 dark:text-primary/60">
                                    {metric.label}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            )
        }

        <!-- Tech Stack -->
        {
            page.techStack && (
                <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
                    <h2 class="text-3xl font-semibold mb-8">
                        {page.techStack.title ??
                            (locale === "it"
                                ? "Stack tecnologico"
                                : "Technical stack")}
                    </h2>
                    <div class="grid md:grid-cols-2 gap-8">
                        {page.techStack.items?.map((section) => (
                            <div>
                                <h3 class="font-semibold text-lg mb-3 text-secondary dark:text-primary">
                                    {section.category}
                                </h3>
                                <div class="flex flex-wrap gap-2">
                                    {section.items.map((item) => (
                                        <span class="px-3 py-1 text-sm bg-secondary/10 dark:bg-primary/10 rounded-full text-secondary dark:text-primary">
                                            {item}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            )
        }

        <!-- Technologies -->
        {
            page.technologies && page.technologies.length > 0 && (
                <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
                    <h2 class="text-3xl font-semibold mb-8">
                        {locale === "it"
                            ? "Tecnologie usate"
                            : "Technologies used"}
                    </h2>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                        {page.technologies.map((tech) => (
                            <div class="p-4 border border-secondary/20 dark:border-primary/20 rounded-lg">
                                <p class="font-medium text-secondary dark:text-primary">
                                    {tech.name}
                                </p>
                                {tech.proficiency && (
                                    <p class="text-sm text-secondary/60 dark:text-primary/60">
                                        {tech.proficiency}
                                    </p>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            )
        }

        <!-- Gallery -->
        {
            page.gallery && page.gallery.length > 0 && (
                <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
                    <h2 class="text-3xl font-semibold mb-8">
                        {locale === "it" ? "Galleria" : "Gallery"}
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {page.gallery.map((img) => (
                            <img
                                src={img}
                                alt={page.title}
                                class="w-full rounded-lg shadow-sm"
                            />
                        ))}
                    </div>
                </div>
            )
        }

        <!-- Learnings -->
        {
            page.learnings && page.learnings.length > 0 && (
                <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20 mb-20">
                    <h2 class="text-3xl font-semibold mb-4">
                        {locale === "it" ? "Lezioni chiave" : "Key learnings"}
                    </h2>
                    <ul class="space-y-3 text-secondary/75 dark:text-primary/75">
                        {page.learnings.map((item) => (
                            <li class="flex gap-3">
                                <span class="text-secondary dark:text-primary">
                                    ▸
                                </span>
                                <span>{item}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            )
        }
    </div>
</BaseLayout>
