---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLangFromUrl } from "../../../i18n/utils";

export async function getStaticPaths() {
    return [{ params: { locale: "en" } }, { params: { locale: "it" } }];
}

const locale = getLangFromUrl(Astro.url);

const content = {
    en: {
        title: "ETL pipelines & system integrations",
        subtitle:
            "Keeping disparate enterprise systems in sync with a pragmatic, reusable approach",
        period: "2024–2025",
        overview:
            "I built a set of data synchronization pipelines to stop fragile, one-off integrations from slowing the business down. Instead of hammering together bespoke scripts each time, I created reusable client libraries and a small configurable ETL engine so new integrations are reliable and repeatable.",
        challenge:
            "HR, ERP, process automation and PIM lived in separate systems (SuccessFactors, NetSuite, ARIS, a custom PIM). Each new data flow meant rewriting glue code and risking production. That made launches slow and operational support painful.",
        solution:
            "I split the problem into three practical layers: small, reusable service clients; a transformation engine driven by a simple Expr-based configuration; and an orchestration layer that runs and monitors pipelines. Each piece is versioned and tested independently so teams can add a connector without touching everything else.",
        keyAchievements: [
            {
                title: "Near-real-time sync",
                description:
                    "Delivered a SuccessFactors ↔ ARIS sync that reduced stale data windows from hours to minutes. It runs as a Kubernetes cron job and tolerates transient failures.",
            },
            {
                title: "Config-driven field mapping",
                description:
                    "Built an Expr-based mapping format so product managers can tweak field rules without a deploy. It supports computed fields and conditional transforms.",
            },
            {
                title: "Reusable client libraries",
                description:
                    "Implemented small Go clients for NetSuite, ARIS and the internal PIM so new pipelines start from working code instead of a blank file.",
            },
            {
                title: "Production reliability",
                description:
                    "Added retry logic, validation checks and clear observability so failures surface promptly and recover automatically where safe.",
            },
            {
                title: "Scalable architecture",
                description:
                    "Designed the pipeline to run many syncs in parallel without cross-contamination and to make backfills and ad-hoc exports straightforward.",
            },
        ],
        technologies: [
            { name: "Go", proficiency: "Expert" },
            { name: "Kotlin", proficiency: "Advanced" },
            { name: "gRPC", proficiency: "Advanced" },
            { name: "PostgreSQL", proficiency: "Advanced" },
            { name: "Kubernetes", proficiency: "Intermediate" },
            { name: "SAP APIs", proficiency: "Intermediate" },
        ],
        techStack: {
            title: "Technical stack",
            items: [
                { category: "Languages", items: ["Go", "Kotlin", "YAML"] },
                {
                    category: "Platforms",
                    items: ["Kubernetes", "Docker", "Linux"],
                },
                { category: "Protocols", items: ["gRPC", "REST", "OAuth2"] },
                {
                    category: "Data processing",
                    items: ["Expr (mapping)", "JSON Schema", "Streaming"],
                },
                { category: "Storage", items: ["PostgreSQL", "Redis"] },
                {
                    category: "CI / CD",
                    items: ["GitHub Actions", "Docker Compose"],
                },
            ],
        },
        metrics: [
            { label: "Systems integrated", value: "4+" },
            { label: "Sync latency", value: "minutes" },
            { label: "Mapping rules", value: "100+" },
            { label: "Pipeline success rate", value: ">99.5%" },
        ],
        learnings: [
            "Treat integrations as products: they need releases, tests and clear ownership.",
            "Configuration beats copy-paste. Giving non-developers safe knobs (mapping rules) saves time and reduces risk.",
            "Good observability turns noisy support tickets into quick rollbacks and targeted fixes.",
            "Small, well-tested client libraries dramatically shorten onboarding for new connectors.",
        ],
    },

    it: {
        title: "Pipeline ETL e integrazioni di sistema",
        subtitle:
            "Sincronizzare sistemi enterprise senza ricominciare ogni volta da zero",
        period: "2024–2025",
        overview:
            "Ho realizzato pipeline di sincronizzazione dati per eliminare integrazioni fragili e ripetitive. Invece di riscrivere script ad-hoc per ogni caso, ho creato librerie riutilizzabili e un motore ETL configurabile in modo che le nuove integrazioni siano affidabili e ripetibili.",
        challenge:
            "HR, ERP, process automation e PIM (SuccessFactors, NetSuite, ARIS e un PIM interno) vivevano separati. Ogni nuovo flusso richiedeva riscritture di codice di collegamento e metteva a rischio la produzione, rallentando le release e aumentando il carico operativo.",
        solution:
            "Ho diviso il problema in tre livelli pratici: client di servizio piccoli e riutilizzabili; un motore di trasformazione configurato con Expr; e un livello di orchestrazione che esegue e monitora le pipeline. Ogni componente ha versioning e test indipendenti, così si può aggiungere un connector senza toccare il resto.",
        keyAchievements: [
            {
                title: "Sincronizzazione quasi in tempo reale",
                description:
                    "Conseguita la sincronizzazione SuccessFactors ↔ ARIS che ha ridotto il delay da ore a minuti. Il job gira come cron su Kubernetes e resiste a errori transitori.",
            },
            {
                title: "Mappature configurabili",
                description:
                    "Creato un formato di mapping basato su Expr: i product manager possono modificare regole senza deploy; supporta campi calcolati e condizioni.",
            },
            {
                title: "Librerie client riutilizzabili",
                description:
                    "Implementate librerie Go per NetSuite, ARIS e il PIM interno: partire da codice funzionante è molto più veloce che ricominciare da zero.",
            },
            {
                title: "Affidabilità in produzione",
                description:
                    "Aggiunti retry, controlli di validazione e osservabilità chiara: i fallimenti si segnalano subito e si può recuperare quando possibile.",
            },
            {
                title: "Architettura scalabile",
                description:
                    "Il design delle pipeline permette esecuzioni parallele senza contaminazione e rende semplici retry, backfill ed esportazioni ad-hoc.",
            },
        ],
        technologies: [
            { name: "Go", proficiency: "Expert" },
            { name: "Kotlin", proficiency: "Avanzato" },
            { name: "gRPC", proficiency: "Avanzato" },
            { name: "PostgreSQL", proficiency: "Avanzato" },
            { name: "Kubernetes", proficiency: "Intermedio" },
            { name: "SAP APIs", proficiency: "Intermedio" },
        ],
        techStack: {
            title: "Stack tecnologico",
            items: [
                { category: "Linguaggi", items: ["Go", "Kotlin", "YAML"] },
                {
                    category: "Piattaforme",
                    items: ["Kubernetes", "Docker", "Linux"],
                },
                { category: "Protocolli", items: ["gRPC", "REST", "OAuth2"] },
                {
                    category: "Elaborazione dati",
                    items: ["Expr (mapping)", "JSON Schema", "Streaming"],
                },
                { category: "Storage", items: ["PostgreSQL", "Redis"] },
                {
                    category: "CI / CD",
                    items: ["GitHub Actions", "Docker Compose"],
                },
            ],
        },
        metrics: [
            { label: "Sistemi integrati", value: "4+" },
            { label: "Latency sincronizzazione", value: "minuti" },
            { label: "Regole di mapping", value: "100+" },
            { label: "Success rate pipeline", value: ">99.5%" },
        ],
        learnings: [
            "Le integrazioni vanno trattate come prodotti: hanno bisogno di release, test e ownership.",
            "La configurazione batte la copia del codice: dare controlli sicuri a non-developer riduce i rischi.",
            "L'osservabilità ben fatta trasforma ticket rumorosi in rollback rapidi e fix mirati.",
            "Librerie client piccole e testate accelerano molto l'onboarding di nuovi connector.",
        ],
    },
};

const page = content[locale];
---

<BaseLayout>
    <div
        class="min-h-screen bg-primary dark:bg-secondary text-secondary dark:text-primary"
    >
        <!-- Hero Section -->
        <div class="max-w-4xl mx-auto px-8 py-20">
            <div class="mb-4">
                <span
                    class="text-sm font-medium text-secondary/60 dark:text-primary/60"
                    >{page.period}</span
                >
            </div>
            <h1 class="text-4xl md:text-5xl font-bold mb-4">{page.title}</h1>
            <p class="text-xl text-secondary/80 dark:text-primary/80 mb-8">
                {page.subtitle}
            </p>
            <p
                class="text-lg leading-relaxed text-secondary/75 dark:text-primary/75"
            >
                {page.overview}
            </p>
        </div>

        <!-- Challenge & Solution -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <div class="grid md:grid-cols-2 gap-12">
                <div>
                    <h2 class="text-2xl font-semibold mb-4">
                        {locale === "it" ? "Sfida" : "Challenge"}
                    </h2>
                    <p
                        class="text-secondary/75 dark:text-primary/75 leading-relaxed"
                    >
                        {page.challenge}
                    </p>
                </div>
                <div>
                    <h2 class="text-2xl font-semibold mb-4">
                        {locale === "it" ? "Soluzione" : "Solution"}
                    </h2>
                    <p
                        class="text-secondary/75 dark:text-primary/75 leading-relaxed"
                    >
                        {page.solution}
                    </p>
                </div>
            </div>
        </div>

        <!-- Key Achievements -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Risultati Chiave" : "Key Achievements"}
            </h2>
            <div class="grid md:grid-cols-2 gap-6">
                {
                    page.keyAchievements.map((achievement) => (
                        <div class="border-l-2 border-secondary/30 dark:border-primary/30 pl-6 py-2">
                            <h3 class="text-lg font-semibold mb-2">
                                {achievement.title}
                            </h3>
                            <p class="text-secondary/70 dark:text-primary/70 text-sm leading-relaxed">
                                {achievement.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Metrics -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Impatto" : "Impact"}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {
                    page.metrics.map((metric) => (
                        <div class="text-center">
                            <p class="text-4xl font-bold text-secondary dark:text-primary mb-2">
                                {metric.value}
                            </p>
                            <p class="text-sm text-secondary/60 dark:text-primary/60">
                                {metric.label}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Tech Stack -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">{page.techStack.title}</h2>
            <div class="grid md:grid-cols-2 gap-8">
                {
                    page.techStack.items.map((section) => (
                        <div>
                            <h3 class="font-semibold text-lg mb-3 text-secondary dark:text-primary">
                                {section.category}
                            </h3>
                            <div class="flex flex-wrap gap-2">
                                {section.items.map((item) => (
                                    <span class="px-3 py-1 text-sm bg-secondary/10 dark:bg-primary/10 rounded-full text-secondary dark:text-primary">
                                        {item}
                                    </span>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Technologies -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Tecnologie Usate" : "Technologies Used"}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {
                    page.technologies.map((tech) => (
                        <div class="p-4 border border-secondary/20 dark:border-primary/20 rounded-lg">
                            <p class="font-medium text-secondary dark:text-primary">
                                {tech.name}
                            </p>
                            <p class="text-sm text-secondary/60 dark:text-primary/60">
                                {tech.proficiency}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Learnings -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20 mb-20"
        >
            <h2 class="text-3xl font-semibold mb-4">
                {locale === "it" ? "Lezioni Apprese" : "Key Learnings"}
            </h2>
            <ul class="space-y-3 text-secondary/75 dark:text-primary/75">
                {
                    page.learnings.map((item) => (
                        <li class="flex gap-3">
                            <span class="text-secondary dark:text-primary">
                                ▸
                            </span>
                            <span>{item}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</BaseLayout>
