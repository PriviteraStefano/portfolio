---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLangFromUrl } from "../../../i18n/utils";

export async function getStaticPaths() {
    return [{ params: { locale: "en" } }, { params: { locale: "it" } }];
}

const locale = getLangFromUrl(Astro.url);

const content = {
    en: {
        title: "Enterprise supplier portal",
        subtitle: "Modernized frontend for a multi-service supplier platform",
        period: "Jul - Present",
        overview:
            "I led the frontend work for a supplier portal used across many teams. We consolidated scattered React apps written in JavaScript into a single TypeScript codebase, improved developer workflows, and made the UI more predictable for users and integrators.",
        challenge:
            "The portal had grown organically in dozens of repositories. Different teams copied similar code, patterns diverged, and TypeScript coverage was low. That made changes slow, introduced bugs, and made on-boarding new developers harder.",
        solution:
            "We moved to a centralized frontend architecture using React + TypeScript and a shared component library. I introduced consistent patterns for state and API integration, set up incremental migration paths so services could move at their own pace, and added tests and automation to reduce regressions.",
        keyAchievements: [
            {
                title: "Shared component library",
                description:
                    "Built a small, well-documented component library that replaced duplicated UI code and made interfaces consistent across services.",
            },
            {
                title: "Incremental migration",
                description:
                    "Migrated services gradually to TypeScript and the new architecture to avoid big-bang rewrites and reduce downtime.",
            },
            {
                title: "Developer experience",
                description:
                    "Standardized linting, CI checks, and local dev tooling so onboarding and day-to-day work are faster and less error-prone.",
            },
            {
                title: "Service abstraction",
                description:
                    "Created clear API integration layers so frontend teams can work with multiple backend services without repeating business logic.",
            },
            {
                title: "Performance work",
                description:
                    "Reduced bundle size, added code-splitting and lazy loading in key areas to improve perceived page speed.",
            },
        ],
        technologies: [
            { name: "React", proficiency: "Expert" },
            { name: "TypeScript", proficiency: "Expert" },
            { name: "Vite", proficiency: "Advanced" },
            { name: "TanStack Query", proficiency: "Advanced" },
            { name: "gRPC / REST", proficiency: "Advanced" },
            { name: "Playwright", proficiency: "Intermediate" },
        ],
        techStack: {
            title: "Technical stack",
            items: [
                {
                    category: "Frontend",
                    items: ["React", "TypeScript", "Vite", "TailwindCSS"],
                },
                {
                    category: "State & Data",
                    items: ["TanStack Query", "Zustand"],
                },
                { category: "APIs", items: ["gRPC", "REST", "OpenAPI"] },
                { category: "Infra", items: ["Docker", "Kubernetes", "AWS"] },
                {
                    category: "Testing",
                    items: ["Vitest", "Playwright", "React Testing Library"],
                },
            ],
        },
        metrics: [
            { label: "Services integrated", value: "10+" },
            { label: "TypeScript coverage", value: "100%" },
            { label: "Bundle size reduction", value: "35%" },
            { label: "Page load time", value: "-45%" },
        ],
        learnings: [
            "TypeScript reduces a lot of wasted time — not a magic fix, but it helps.",
            "Small shared components plus clear docs beats large UI frameworks for maintenance.",
            "Incremental migration keeps the business running while the code improves.",
            "Designing APIs with frontends in mind makes orchestration far simpler.",
        ],
    },
    it: {
        title: "Portale fornitori enterprise",
        subtitle: "Modernizzazione frontend per una piattaforma multi-servizio",
        period: "Lug - Presente",
        overview:
            "Ho guidato il lavoro frontend per un portale fornitori usato da più team. Abbiamo consolidato varie app React in JavaScript in un unico codebase TypeScript, migliorando i flussi di lavoro degli sviluppatori e rendendo l'interfaccia più prevedibile per utenti e integrazioni.",
        challenge:
            "Il portale era cresciuto in modo organico su molteplici repository. I team duplicavano codice, i pattern non erano allineati e la copertura TypeScript era bassa. Questo rallentava le modifiche, introdusse bug e rendeva l'onboarding più difficile.",
        solution:
            "Abbiamo adottato un'architettura frontend centralizzata basata su React + TypeScript e una libreria di componenti condivisa. Ho introdotto pattern coerenti per lo stato e l'integrazione API, creato un percorso di migrazione incrementale per i servizi e aggiunto test e automazioni per ridurre i regressi.",
        keyAchievements: [
            {
                title: "Libreria di componenti condivisa",
                description:
                    "Costruita una libreria leggera e documentata che ha sostituito codice UI duplicato, uniformando le interfacce tra i servizi.",
            },
            {
                title: "Migrazione incrementale",
                description:
                    "Trasferimento graduale dei servizi a TypeScript e alla nuova architettura per evitare riscritture massive e ridurre i rischi.",
            },
            {
                title: "Sviluppatore esperienza",
                description:
                    "Standardizzati linting, controlli CI e strumenti locali per velocizzare l'onboarding e ridurre errori quotidiani.",
            },
            {
                title: "Astrazione dei servizi",
                description:
                    "Creati strati chiari per l'integrazione API così che i frontend possano usare più servizi senza duplicare logica di business.",
            },
            {
                title: "Ottimizzazione performance",
                description:
                    "Ridotto bundle size, introdotto code-splitting e lazy loading nelle aree critiche per migliorare la velocità percepita.",
            },
        ],
        technologies: [
            { name: "React", proficiency: "Expert" },
            { name: "TypeScript", proficiency: "Expert" },
            { name: "Vite", proficiency: "Avanzato" },
            { name: "TanStack Query", proficiency: "Avanzato" },
            { name: "gRPC / REST", proficiency: "Avanzato" },
            { name: "Playwright", proficiency: "Intermedio" },
        ],
        techStack: {
            title: "Stack tecnologico",
            items: [
                {
                    category: "Frontend",
                    items: ["React", "TypeScript", "Vite", "TailwindCSS"],
                },
                {
                    category: "Stato & Dati",
                    items: ["TanStack Query", "Zustand"],
                },
                { category: "APIs", items: ["gRPC", "REST", "OpenAPI"] },
                { category: "Infra", items: ["Docker", "Kubernetes", "AWS"] },
                {
                    category: "Testing",
                    items: ["Vitest", "Playwright", "React Testing Library"],
                },
            ],
        },
        metrics: [
            { label: "Servizi integrati", value: "10+" },
            { label: "Copertura TypeScript", value: "100%" },
            { label: "Riduzione bundle", value: "35%" },
            { label: "Tempo di caricamento", value: "-45%" },
        ],
        learnings: [
            "TypeScript fa risparmiare tempo: non risolve tutto, ma evita molti errori.",
            "Componenti piccoli e documentati aiutano più di grandi framework personalizzati.",
            "La migrazione incrementale permette di migliorare il codice senza bloccare il business.",
            "Progettare le API pensando al frontend semplifica molto l'orchestrazione.",
        ],
    },
};

const page = content[locale];
---

<BaseLayout>
    <div
        class="min-h-screen bg-primary dark:bg-secondary text-secondary dark:text-primary"
    >
        <!-- Hero Section -->
        <div class="max-w-4xl mx-auto px-8 py-20">
            <div class="mb-4">
                <span
                    class="text-sm font-medium text-secondary/60 dark:text-primary/60"
                    >{page.period}</span
                >
            </div>
            <h1 class="text-4xl md:text-5xl font-bold mb-4">{page.title}</h1>
            <p class="text-xl text-secondary/80 dark:text-primary/80 mb-8">
                {page.subtitle}
            </p>
            <p
                class="text-lg leading-relaxed text-secondary/75 dark:text-primary/75"
            >
                {page.overview}
            </p>
        </div>

        <!-- Challenge & Solution -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <div class="grid md:grid-cols-2 gap-12">
                <div>
                    <h2 class="text-2xl font-semibold mb-4">
                        {locale === "it" ? "Sfida" : "Challenge"}
                    </h2>
                    <p
                        class="text-secondary/75 dark:text-primary/75 leading-relaxed"
                    >
                        {page.challenge}
                    </p>
                </div>
                <div>
                    <h2 class="text-2xl font-semibold mb-4">
                        {locale === "it" ? "Soluzione" : "Solution"}
                    </h2>
                    <p
                        class="text-secondary/75 dark:text-primary/75 leading-relaxed"
                    >
                        {page.solution}
                    </p>
                </div>
            </div>
        </div>

        <!-- Key Achievements -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Risultati chiave" : "Key achievements"}
            </h2>
            <div class="grid md:grid-cols-2 gap-6">
                {
                    page.keyAchievements.map((achievement) => (
                        <div class="border-l-2 border-secondary/30 dark:border-primary/30 pl-6 py-2">
                            <h3 class="text-lg font-semibold mb-2">
                                {achievement.title}
                            </h3>
                            <p class="text-secondary/70 dark:text-primary/70 text-sm leading-relaxed">
                                {achievement.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Metrics -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Impatto" : "Impact"}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {
                    page.metrics.map((metric) => (
                        <div class="text-center">
                            <p class="text-4xl font-bold text-secondary dark:text-primary mb-2">
                                {metric.value}
                            </p>
                            <p class="text-sm text-secondary/60 dark:text-primary/60">
                                {metric.label}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Tech Stack -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">{page.techStack.title}</h2>
            <div class="grid md:grid-cols-2 gap-8">
                {
                    page.techStack.items.map((section) => (
                        <div>
                            <h3 class="font-semibold text-lg mb-3 text-secondary dark:text-primary">
                                {section.category}
                            </h3>
                            <div class="flex flex-wrap gap-2">
                                {section.items.map((item) => (
                                    <span class="px-3 py-1 text-sm bg-secondary/10 dark:bg-primary/10 rounded-full text-secondary dark:text-primary">
                                        {item}
                                    </span>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Technologies -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Tecnologie usate" : "Technologies used"}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {
                    page.technologies.map((tech) => (
                        <div class="p-4 border border-secondary/20 dark:border-primary/20 rounded-lg">
                            <p class="font-medium text-secondary dark:text-primary">
                                {tech.name}
                            </p>
                            <p class="text-sm text-secondary/60 dark:text-primary/60">
                                {tech.proficiency}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Learnings -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20 mb-20"
        >
            <h2 class="text-3xl font-semibold mb-4">
                {locale === "it" ? "Lezioni chiave" : "Key learnings"}
            </h2>
            <ul class="space-y-3 text-secondary/75 dark:text-primary/75">
                {
                    page.learnings.map((item) => (
                        <li class="flex gap-3">
                            <span class="text-secondary dark:text-primary">
                                ▸
                            </span>
                            <span>{item}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</BaseLayout>
