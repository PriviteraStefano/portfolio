---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLangFromUrl } from "../../../i18n/utils";

export async function getStaticPaths() {
    return [{ params: { locale: "en" } }, { params: { locale: "it" } }];
}

const locale = getLangFromUrl(Astro.url);

const content = {
    en: {
        title: "PIM frontend modernization",
        subtitle:
            "Turned a fragmented UI into a single, maintainable design system",
        period: "Jan - Apr 2024",
        overview:
            "I rebuilt the PIM frontend to stop fighting the UI. Over the years the app had picked up Material UI, Chakra, and a pile of custom components — the result was inconsistent behavior and slower development. I replaced that mess with a single ShadcnUI-based design system, cleaned up interactions, and made everyday tasks noticeably faster for the people who use the product.",
        challenge:
            "Different teams had added different UI libraries as needs arose. Buttons looked different across pages, forms behaved inconsistently, and small visual differences caused repeated bugfixes. The frontend was hard to maintain, and shipping new features required too much manual polishing.",
        solution:
            "I chose ShadcnUI as a pragmatic, accessible foundation and rewrote the most-used components first. The work included a component library, design tokens, accessible defaults, and a migration plan that let the team roll changes out incrementally. I focused on the flows editors use most: multi-select lists, bulk edits, inline editing, and clear media previews.",
        keyAchievements: [
            {
                title: "One design system",
                description:
                    "Replaced multiple UI libraries with a single ShadcnUI component library so components behave the same everywhere.",
            },
            {
                title: "Fewer surprises for users",
                description:
                    "Standardized form controls, loading states, and error handling so editors run fewer manual checks and recover faster from mistakes.",
            },
            {
                title: "Faster data operations",
                description:
                    "Added multi-select, bulk edit, and inline editing flows that cut repetitive work for power users.",
            },
            {
                title: "Media management that works",
                description:
                    "Built image and PDF previews into the PIM so media can be inspected before publishing, reducing bad uploads.",
            },
            {
                title: "Cleaner codebase",
                description:
                    "Refactored and documented components, making future changes safer and faster for the team.",
            },
        ],
        technologies: [
            { name: "React", proficiency: "Expert" },
            { name: "TypeScript", proficiency: "Expert" },
            { name: "ShadcnUI", proficiency: "Advanced" },
            { name: "Tailwind CSS", proficiency: "Advanced" },
            { name: "Go", proficiency: "Intermediate" },
            { name: "Neo4j", proficiency: "Intermediate" },
        ],
        techStack: {
            title: "Technical stack",
            items: [
                {
                    category: "Frontend",
                    items: ["React", "TypeScript", "ShadcnUI", "Tailwind CSS"],
                },
                { category: "Styling", items: ["Tailwind CSS", "CSS Modules"] },
                { category: "State", items: ["React Hooks", "Context API"] },
                { category: "Backend", items: ["Go", "gRPC"] },
                { category: "Database", items: ["Neo4j", "Cypher"] },
            ],
        },
        metrics: [
            { label: "Component variants removed", value: "40%" },
            { label: "Development time saved", value: "~25%" },
            { label: "UI consistency", value: "High" },
            { label: "New editor features", value: "7+" },
        ],
        learnings: [
            "A single design system reduces friction more than any one fancy component library.",
            "Ship the smallest consistent piece first — migrating all buttons at once beats piecemeal fixes.",
            "Accessibility and sensible defaults save time later; it’s worth doing this early.",
            "Listen to editors — small UX changes can remove hours of repetitive work.",
        ],
    },
    it: {
        title: "Modernizzazione frontend PIM",
        subtitle:
            "Da librerie UI sparse a un sistema di design unico e sostenibile",
        period: "Gen - Apr 2024",
        overview:
            "Ho riscritto il frontend del PIM per smettere di lottare contro la UI. Nel tempo l'app aveva accumulato Material UI, Chakra e molti componenti custom: il risultato era incoerenza visiva e sviluppo rallentato. Ho sostituito tutto con un design system basato su ShadcnUI, ho ripulito le interazioni e ho reso le operazioni quotidiane più rapide per chi lavora sul prodotto.",
        challenge:
            "Team diversi avevano aggiunto librerie UI ad-hoc. Pulsanti e form si comportavano in modo diverso a seconda della pagina, e le piccole differenze causavano continue correzioni. Il frontend era difficile da mantenere e rilasciare nuove funzionalità richiedeva troppo lavoro manuale.",
        solution:
            "Ho scelto ShadcnUI come base pratica e accessibile e ho riscritto prima i componenti più usati. Il lavoro ha incluso una component library, design token, impostazioni accessibili di default e un piano di migrazione per rilasciare i cambiamenti per fasi. Mi sono concentrato sui flussi principali: multi-select, bulk edit, editing inline e anteprime media.",
        keyAchievements: [
            {
                title: "Un unico sistema di design",
                description:
                    "Sostituiti più framework UI con una libreria di componenti ShadcnUI: i componenti si comportano uguali ovunque.",
            },
            {
                title: "Meno sorprese per gli utenti",
                description:
                    "Standardizzati controlli, stati di caricamento e gestione errori: gli editor fanno meno controlli manuali e recuperano più velocemente dagli errori.",
            },
            {
                title: "Operazioni dati più veloci",
                description:
                    "Aggiunti multi-select, bulk edit e editing inline per ridurre il lavoro ripetitivo degli utenti avanzati.",
            },
            {
                title: "Gestione media efficace",
                description:
                    "Implementate anteprime immagine e PDF nel PIM per controllare i media prima della pubblicazione, riducendo upload errati.",
            },
            {
                title: "Codebase più pulita",
                description:
                    "Refactor e documentazione dei componenti per rendere le modifiche future più sicure e rapide.",
            },
        ],
        technologies: [
            { name: "React", proficiency: "Expert" },
            { name: "TypeScript", proficiency: "Expert" },
            { name: "ShadcnUI", proficiency: "Avanzato" },
            { name: "Tailwind CSS", proficiency: "Avanzato" },
            { name: "Go", proficiency: "Intermedio" },
            { name: "Neo4j", proficiency: "Intermedio" },
        ],
        techStack: {
            title: "Stack tecnologico",
            items: [
                {
                    category: "Frontend",
                    items: ["React", "TypeScript", "ShadcnUI", "Tailwind CSS"],
                },
                { category: "Styling", items: ["Tailwind CSS", "CSS Modules"] },
                { category: "State", items: ["React Hooks", "Context API"] },
                { category: "Backend", items: ["Go", "gRPC"] },
                { category: "Database", items: ["Neo4j", "Cypher"] },
            ],
        },
        metrics: [
            { label: "Varianti componenti rimosse", value: "40%" },
            { label: "Tempo sviluppo risparmiato", value: "~25%" },
            { label: "Coerenza UI", value: "Alta" },
            { label: "Nuove funzionalità editor", value: "7+" },
        ],
        learnings: [
            "Un unico sistema di design riduce le frizioni più di qualsiasi singola libreria.",
            "Rilasciare prima la parte più piccola e coerente semplifica la migrazione completa.",
            "Accessibilità e default sensati risparmiano tempo in seguito; vale la pena investirci subito.",
            "Ascoltare gli editor: piccoli miglioramenti UX spesso eliminano ore di lavoro ripetitivo.",
        ],
    },
};

const page = content[locale];
---

<BaseLayout>
    <div
        class="min-h-screen bg-primary dark:bg-secondary text-secondary dark:text-primary"
    >
        <!-- Hero Section -->
        <div class="max-w-4xl mx-auto px-8 py-20">
            <div class="mb-4">
                <span
                    class="text-sm font-medium text-secondary/60 dark:text-primary/60"
                    >{page.period}</span
                >
            </div>
            <h1 class="text-4xl md:text-5xl font-bold mb-4">{page.title}</h1>
            <p class="text-xl text-secondary/80 dark:text-primary/80 mb-8">
                {page.subtitle}
            </p>
            <p
                class="text-lg leading-relaxed text-secondary/75 dark:text-primary/75"
            >
                {page.overview}
            </p>
        </div>

        <!-- Challenge & Solution -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <div class="grid md:grid-cols-2 gap-12">
                <div>
                    <h2 class="text-2xl font-semibold mb-4">
                        {locale === "it" ? "Sfida" : "Challenge"}
                    </h2>
                    <p
                        class="text-secondary/75 dark:text-primary/75 leading-relaxed"
                    >
                        {page.challenge}
                    </p>
                </div>
                <div>
                    <h2 class="text-2xl font-semibold mb-4">
                        {locale === "it" ? "Soluzione" : "Solution"}
                    </h2>
                    <p
                        class="text-secondary/75 dark:text-primary/75 leading-relaxed"
                    >
                        {page.solution}
                    </p>
                </div>
            </div>
        </div>

        <!-- Key Achievements -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Risultati Chiave" : "Key Achievements"}
            </h2>
            <div class="grid md:grid-cols-2 gap-6">
                {
                    page.keyAchievements.map((achievement) => (
                        <div class="border-l-2 border-secondary/30 dark:border-primary/30 pl-6 py-2">
                            <h3 class="text-lg font-semibold mb-2">
                                {achievement.title}
                            </h3>
                            <p class="text-secondary/70 dark:text-primary/70 text-sm leading-relaxed">
                                {achievement.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Metrics -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Impatto" : "Impact"}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {
                    page.metrics.map((metric) => (
                        <div class="text-center">
                            <p class="text-4xl font-bold text-secondary dark:text-primary mb-2">
                                {metric.value}
                            </p>
                            <p class="text-sm text-secondary/60 dark:text-primary/60">
                                {metric.label}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Tech Stack -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">{page.techStack.title}</h2>
            <div class="grid md:grid-cols-2 gap-8">
                {
                    page.techStack.items.map((section) => (
                        <div>
                            <h3 class="font-semibold text-lg mb-3 text-secondary dark:text-primary">
                                {section.category}
                            </h3>
                            <div class="flex flex-wrap gap-2">
                                {section.items.map((item) => (
                                    <span class="px-3 py-1 text-sm bg-secondary/10 dark:bg-primary/10 rounded-full text-secondary dark:text-primary">
                                        {item}
                                    </span>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Technologies -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20"
        >
            <h2 class="text-3xl font-semibold mb-8">
                {locale === "it" ? "Tecnologie Usate" : "Technologies Used"}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {
                    page.technologies.map((tech) => (
                        <div class="p-4 border border-secondary/20 dark:border-primary/20 rounded-lg">
                            <p class="font-medium text-secondary dark:text-primary">
                                {tech.name}
                            </p>
                            <p class="text-sm text-secondary/60 dark:text-primary/60">
                                {tech.proficiency}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Learnings -->
        <div
            class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20 mb-20"
        >
            <h2 class="text-3xl font-semibold mb-4">
                {locale === "it" ? "Lezioni Chiave" : "Key Learnings"}
            </h2>
            <ul class="space-y-3 text-secondary/75 dark:text-primary/75">
                {
                    (page.learnings || page.learnings).map((lesson) => (
                        <li class="flex gap-3">
                            <span class="text-secondary dark:text-primary">
                                ▸
                            </span>
                            <span class="leading-relaxed">{lesson}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</BaseLayout>
