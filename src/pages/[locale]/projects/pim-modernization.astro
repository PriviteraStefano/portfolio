---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLangFromUrl } from "../../../i18n/utils";

export async function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'it' } },
  ];
}

const locale = getLangFromUrl(Astro.url);

const content = {
  en: {
    title: "PIM Application Frontend Modernization",
    subtitle: "Unified disparate UI libraries into cohesive design system",
    period: "Jan - Apr 2024",
    overview: "Completely redesigned and rebuilt the frontend of a legacy Product Information Management (PIM) system that had accumulated UI inconsistencies over years of development. Replaced a fragmented mix of Material UI, Chakra UI, and custom components with a unified ShadcnUI design system.",
    challenge: "The PIM application (React+TS Frontend, Go backend, Neo4j database) had evolved over years with developers adding different UI libraries as needed. This resulted in: inconsistent user experience, difficult to maintain code, poor UX patterns and friction for both users and developers. The codebase was starting to become unmaintainable.",
    solution: "Chose ShadcnUI as the foundation for complete frontend rewrite. This allowed consistent component design, accessibility out-of-the-box and maintainable component architecture. Enhanced UX with new interaction patterns: multi-select, bulk operations, inline editing and hierarchical data visualization.",
    keyAchievements: [
      {
        title: "Design System Unification",
        description: "Replaced Material UI + Chakra UI + custom components with unified ShadcnUI system. Resulted in a reduction in component code and consistent visual language."
      },
      {
        title: "Enhanced Data Operations",
        description: "Implemented multi-select, bulk editing, inline cell editing and hierarchical data visualization enabling power users to work more efficiently."
      },
      {
        title: "Media Asset Management",
        description: "Added comprehensive media asset management system with image and PDF previews, enabling better control and visibility of product media."
      },
      {
        title: "User Experience Improvements",
        description: "Improved UX across the entire application through better interaction design, loading states, error handling and responsive layouts."
      },
      {
        title: "Maintainability",
        description: "New codebase is well-structured, documented and uses consistent patterns making future development faster and safer."
      }
    ],
    technologies: [
      { name: "React", proficiency: "Expert" },
      { name: "TypeScript", proficiency: "Expert" },
      { name: "ShadcnUI", proficiency: "Advanced" },
      { name: "Tailwind CSS", proficiency: "Advanced" },
      { name: "Go", proficiency: "Intermediate" },
      { name: "Neo4j", proficiency: "Intermediate" },
    ],
    techStack: {
      title: "Technical Stack",
      items: [
        { category: "Frontend", items: ["React", "TypeScript", "ShadcnUI", "Tailwind CSS"] },
        { category: "Styling", items: ["Tailwind CSS", "CSS Modules"] },
        { category: "State Management", items: ["React Hooks", "Context API"] },
        { category: "Backend", items: ["Go", "gRPC"] },
        { category: "Database", items: ["Neo4j", "Cypher"] },
      ]
    },
    metrics: [
      { label: "Component Code Reduction", value: "40%" },
      { label: "Development Time Saved", value: "~25%" },
      { label: "UI Consistency", value: "100%" },
      { label: "New Features Added", value: "7+" },
    ]
  },
  it: {
    title: "Modernizzazione Frontend Applicazione PIM",
    subtitle: "Unificato librerie UI disparate in sistema design coeso",
    period: "Gen - Apr 2024",
    overview: "Ho completamente riprogettato e riscritto il frontend di una applicazione legacy di gestione informazioni prodotto (PIM) che aveva accumulato inconsistenze UI durante anni di sviluppo. Ho sostituito mix fragmentato di Material UI, Chakra UI, e componenti custom con sistema design unificato ShadcnUI.",
    challenge: "Applicazione PIM (backend Go, database Neo4j) era evoluta anni con developers aggiungendo diverse librerie UI come necessario. Questo ha risultato in: esperienza utente inconsistente, codice difficile mantenere, pattern UX poveri, frizione per users e developers. Codebase era unmaintainable.",
    solution: "Ho scelto ShadcnUI come fondazione per riscrittura frontend completa. Questo ha permesso design component consistente, accessibilità out-of-the-box, architettura component maintainable. Ho migliorato UX con nuovi pattern interazione: multi-select, bulk operations, inline editing, visualizzazione dati gerarchica.",
    keyAchievements: [
      {
        title: "Unificazione Design System",
        description: "Ho sostituito Material UI + Chakra UI + componenti custom con sistema unificato ShadcnUI. Risultato in riduzione 40% codice component e linguaggio visivo consistente."
      },
      {
        title: "Operazioni Dati Migliorate",
        description: "Ho implementato multi-select, bulk editing, inline cell editing, visualizzazione dati gerarchica abilitando power users lavorare più efficientemente."
      },
      {
        title: "Gestione Asset Media",
        description: "Ho aggiunto sistema gestione asset media completo con preview immagini e PDF, abilitando migliore controllo e visibilità media prodotto."
      },
      {
        title: "Miglioramenti User Experience",
        description: "Ho migliorato UX applicazione intera attraverso migliore design interazione, loading states, error handling, layout responsive."
      },
      {
        title: "Maintainabilità",
        description: "Nuovo codebase è ben-strutturato, documentato, usa pattern consistenti rendendo sviluppo futuro più veloce e sicuro."
      }
    ],
    technologies: [
      { name: "React", proficiency: "Expert" },
      { name: "TypeScript", proficiency: "Expert" },
      { name: "ShadcnUI", proficiency: "Avanzato" },
      { name: "Tailwind CSS", proficiency: "Avanzato" },
      { name: "Go", proficiency: "Intermedio" },
      { name: "Neo4j", proficiency: "Intermedio" },
    ],
    techStack: {
      title: "Stack Tecnologico",
      items: [
        { category: "Frontend", items: ["React", "TypeScript", "ShadcnUI", "Tailwind CSS"] },
        { category: "Styling", items: ["Tailwind CSS", "CSS Modules"] },
        { category: "State Management", items: ["React Hooks", "Context API"] },
        { category: "Backend", items: ["Go", "gRPC"] },
        { category: "Database", items: ["Neo4j", "Cypher"] },
      ]
    },
    metrics: [
      { label: "Riduzione Codice Component", value: "40%" },
      { label: "Tempo Sviluppo Risparmiato", value: "~25%" },
      { label: "Consistenza UI", value: "100%" },
      { label: "Nuove Features Aggiunte", value: "7+" },
    ]
  }
};

const page = content[locale];
---

<BaseLayout>
  <div class="min-h-screen bg-primary dark:bg-secondary text-secondary dark:text-primary">
    <!-- Hero Section -->
    <div class="max-w-4xl mx-auto px-8 py-20">
      <div class="mb-4">
        <span class="text-sm font-medium text-secondary/60 dark:text-primary/60">{page.period}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{page.title}</h1>
      <p class="text-xl text-secondary/80 dark:text-primary/80 mb-8">{page.subtitle}</p>
      <p class="text-lg leading-relaxed text-secondary/75 dark:text-primary/75">{page.overview}</p>
    </div>

    <!-- Challenge & Solution -->
    <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-semibold mb-4">{locale === 'it' ? 'Sfida' : 'Challenge'}</h2>
          <p class="text-secondary/75 dark:text-primary/75 leading-relaxed">{page.challenge}</p>
        </div>
        <div>
          <h2 class="text-2xl font-semibold mb-4">{locale === 'it' ? 'Soluzione' : 'Solution'}</h2>
          <p class="text-secondary/75 dark:text-primary/75 leading-relaxed">{page.solution}</p>
        </div>
      </div>
    </div>

    <!-- Key Achievements -->
    <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
      <h2 class="text-3xl font-semibold mb-8">{locale === 'it' ? 'Risultati Chiave' : 'Key Achievements'}</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {page.keyAchievements.map((achievement) => (
          <div class="border-l-2 border-secondary/30 dark:border-primary/30 pl-6 py-2">
            <h3 class="text-lg font-semibold mb-2">{achievement.title}</h3>
            <p class="text-secondary/70 dark:text-primary/70 text-sm leading-relaxed">{achievement.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Metrics -->
    <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
      <h2 class="text-3xl font-semibold mb-8">{locale === 'it' ? 'Impatto' : 'Impact'}</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {page.metrics.map((metric) => (
          <div class="text-center">
            <p class="text-4xl font-bold text-secondary dark:text-primary mb-2">{metric.value}</p>
            <p class="text-sm text-secondary/60 dark:text-primary/60">{metric.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Tech Stack -->
    <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
      <h2 class="text-3xl font-semibold mb-8">{page.techStack.title}</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {page.techStack.items.map((section) => (
          <div>
            <h3 class="font-semibold text-lg mb-3 text-secondary dark:text-primary">{section.category}</h3>
            <div class="flex flex-wrap gap-2">
              {section.items.map((item) => (
                <span class="px-3 py-1 text-sm bg-secondary/10 dark:bg-primary/10 rounded-full text-secondary dark:text-primary">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Technologies -->
    <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20">
      <h2 class="text-3xl font-semibold mb-8">{locale === 'it' ? 'Tecnologie Usate' : 'Technologies Used'}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {page.technologies.map((tech) => (
          <div class="p-4 border border-secondary/20 dark:border-primary/20 rounded-lg">
            <p class="font-medium text-secondary dark:text-primary">{tech.name}</p>
            <p class="text-sm text-secondary/60 dark:text-primary/60">{tech.proficiency}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Learnings -->
    <div class="max-w-4xl mx-auto px-8 py-16 border-t border-secondary/20 dark:border-primary/20 mb-20">
      <h2 class="text-3xl font-semibold mb-4">{locale === 'it' ? 'Lezioni Chiave' : 'Key Learnings'}</h2>
      <ul class="space-y-3 text-secondary/75 dark:text-primary/75">
        <li class="flex gap-3">
          <span class="text-secondary dark:text-primary">▸</span>
          <span>{locale === 'it' ? 'Design system coeso è cruciale per user experience consistente e maintenance lungo termine' : 'A cohesive design system is crucial for consistent user experience and long-term maintainability'}</span>
        </li>
        <li class="flex gap-3">
          <span class="text-secondary dark:text-primary">▸</span>
          <span>{locale === 'it' ? 'ShadcnUI fornisce eccellente equilibrio tra customization e accessibility out-of-the-box' : 'ShadcnUI provides excellent balance between customization and accessibility out-of-the-box'}</span>
        </li>
        <li class="flex gap-3">
          <span class="text-secondary dark:text-primary">▸</span>
          <span>{locale === 'it' ? 'Ascoltare feedback utenti durante redesign è essenziale per miglioramenti UX significativi' : 'Listening to user feedback during redesign is essential for meaningful UX improvements'}</span>
        </li>
        <li class="flex gap-3">
          <span class="text-secondary dark:text-primary">▸</span>
          <span>{locale === 'it' ? 'Investimento in refactoring tecnico paga dividendi nei mesi successivi attraverso velocità sviluppo aumentata' : 'Investment in technical refactoring pays dividends in coming months through increased development velocity'}</span>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>
